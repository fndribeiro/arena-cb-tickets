{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arena-cb-tickets",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Static files (logo) served by Workers Static Assets before the worker runs (free).
  "assets": { "directory": "./public" },
  "triggers": { "crons": ["*/5 * * * *"] },
  // Non-secret config (12-factor III). Secrets: `wrangler secret put <NAME>`
  // SESSION_SECRET, ADMIN_EMAILS, MP_ACCESS_TOKEN, MP_WEBHOOK_SECRET
  "vars": {
    "APP_URL": "https://arena-cb-tickets.arena-cb-tickets.workers.dev",
    "GOOGLE_CLIENT_ID": "set-me.apps.googleusercontent.com",
    // PoC: fake gateway until Mercado Pago test credentials are set; switch to "mercadopago" + MP_* secrets.
    "PAYMENT_GATEWAY": "fake",
    "PAYMENT_TEST_MODE": "true",
    "ORDER_TTL_MINUTES": "30",
    "MAX_TICKETS_PER_ORDER": "10"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arena-cb-tickets",
      // Created with `wrangler d1 create arena-cb-tickets --location enam` (closest D1 region to Brazil)
      "database_id": "c415b48f-32ad-4589-b530-812509e5f61a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BANNERS", "bucket_name": "arena-cb-tickets-banners" }]
}
